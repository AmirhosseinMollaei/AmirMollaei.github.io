---
layout: none
permalink: /images/manifest.json
---
{% include base_path %}
{
	"name": {{ site.title | jsonify }},
	"short_name": {{ site.name | jsonify }},
	"description": {{ site.description | jsonify }},
	"start_url": "{{ base_path }}/",
	"lang": {{ site.locale | default: "en" | jsonify }},
	"icons": [
		{
			"src": "{{ base_path }}/images/favicon-192x192.png",
			"sizes": "192x192",
			"type": "image/png"
		},
		{
			"src": "{{ base_path }}/images/favicon-512x512.png",
			"sizes": "512x512",
			"type": "image/png"
		}
	]
}
